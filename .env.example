# Copy to frontend/.env.local. Never commit real secrets.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=ZAR

# Sign sessions (openssl rand -base64 32)
SESSION_SECRET="replace-with-a-long-random-string"

# SQLite folder. Local default is backend/data. On Fly this is /data.
# HAMBA_DATA_DIR=

# Optional. Live recovery notes go through Resend. Without this, local
# recovery still works via /recover/mailbox while you run the app here.
# RESEND_API_KEY=
# HAMBA_MAIL_FROM="Hamba <hello@your-domain>"
